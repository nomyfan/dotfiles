font-family = "Berkeley Mono"
font-family = "BlexMono Nerd Font Mono"
font-size = 14
# theme = dark:vellum-dark,light:vellum-light
theme = vellum-dark
# Use common terminfo for older SSH targets such as Raspberry Pi OS.
term = xterm-256color
shell-integration-features = no-cursor
cursor-style = block
# adjust-cursor-thickness = 3

keybind = super+shift+right=next_tab
keybind = super+shift+left=previous_tab
keybind = super+right=goto_split:right
keybind = super+left=goto_split:left
keybind = super+up=goto_split:up
keybind = super+down=goto_split:down
